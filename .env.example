# API key for the OpenAI-compatible backend.
# If you run through LiteLLM Proxy, put the proxy master key here.
OPENAI_API_KEY=sk-...

# OpenAI-compatible base URL.
# Leave empty to use the local LiteLLM default (http://localhost:4000).
# Examples:
#   https://api.openai.com/v1
#   http://localhost:4000
#   http://host.docker.internal:11434/v1
OPENAI_BASE_URL=

# Default model used when the request body does not override `model`.
# For LiteLLM, this may be either a real model id or a proxy alias exposed as an OpenAI model name.
# For direct Ollama usage, this may be a local model such as `qwen3` or `gemma3:4b`.
DEFAULT_MODEL=gpt-4.1-mini

# Embedding model for the RAG index.
# Local diploma default: qwen3-embedding:4b through Ollama.
# Cloud fallback: text-embedding-3-small through OpenAI.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_BATCH_SIZE=128
EMBEDDING_DIMENSIONS=
EMBEDDING_DIM=2560
EMBEDDING_CACHE_PATH=.cache/embeddings.sqlite
EMBEDDING_REQUEST_TIMEOUT=30

# Qdrant vector store for RAG retrieval.
# In docker compose, QDRANT_URL is overridden to http://qdrant:6333.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=dev-qdrant-key
QDRANT_COLLECTION=documents

# Main multi-format RAG collection.
RAG_INPUT_DIR=data
RAG_PIPELINE_STORAGE_DIR=var/ingestion
RAG_COLLECTION=corporate_rag
RAG_BAREMETAL_COLLECTION=rag_block_03_diploma_baremetal
RAG_CHUNK_SIZE=256
RAG_CHUNK_OVERLAP=32
RAG_SIMILARITY_TOP_K=10
# qwen3-embedding:4b calibrated value; Settings default remains 0.3 for OpenAI 3-small.
RAG_SCORE_THRESHOLD=0.5
RAG_CONDENSE_ENABLED=true
# Optional: requires the local-embeddings extra.
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_TOP_N=5

# Optional model used for stateful chat requests that contain images.
# For local Ollama, use a vision-capable model exposed through the OpenAI-compatible API.
VISION_MODEL=

# Request timeout in seconds for the OpenAI-compatible backend.
REQUEST_TIMEOUT=30

# Optional context size passed to compatible local backends such as Ollama.
# Leave empty unless the selected backend supports `extra_body.options.num_ctx`.
LLM_NUM_CTX=

# Redis connection string used for response caching.
# Example for docker compose: redis://redis:6379/0
# Example for local run with host Redis: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# Async SQLAlchemy database URL used when CHAT_REPOSITORY=postgres.
# Example for local Postgres:
#   postgresql+asyncpg://postgres:postgres@localhost:5432/review_bot
DATABASE_URL=

# Cache TTL for synchronous `/chat` responses, in seconds.
CACHE_TTL_SECONDS=300

# Maximum number of concurrent LLM requests handled by the service.
LLM_MAX_CONCURRENCY=5

# Maximum `/chat` requests per minute per X-User-ID or client IP.
RATE_LIMIT_PER_MIN=30

# Stateful chat storage backend: json or postgres.
CHAT_REPOSITORY=json

# Base directory for JSONL chat storage.
CHAT_STORAGE_DIR=./var/chats

# Context strategy: sliding uses the latest messages, hybrid summarizes old history plus latest messages.
CHAT_CONTEXT_STRATEGY=sliding

# Number of recent messages kept in context before token-budget trimming.
CHAT_CONTEXT_WINDOW=10

# Internal backchannel used by the backend to notify the Telegram bot.
BOT_URL=http://localhost:8081
INTERNAL_TOKEN=changeme
ADMIN_TOKEN=changeme-admin

# Optional OpenAI Moderation API layer for stateful /chats.
MODERATION_OPENAI_ENABLED=false
MODERATION_KEYWORDS_PATH=app/moderation/moderation_keywords.yaml

# Set false only for controlled garak baseline runs.
SECURITY_GUARDRAILS_ENABLED=true

# Application log verbosity.
LOG_LEVEL=INFO

# Whether observability spans may include raw prompt/response content.
# Keep this false in production-like environments.
OBSERVABILITY_INCLUDE_CONTENT=false

# Phoenix collector/UI base URL for trace export.
# You can point either to the full OTLP HTTP path or just to the Phoenix UI host.
# Examples:
#   http://localhost:6006
#   http://phoenix:6006
#   http://localhost:6006/v1/traces
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Disable during local security scans when Phoenix is not running.
PHOENIX_TRACING_ENABLED=true

# Phoenix project name shown in the UI.
PHOENIX_PROJECT_NAME=ai-pr-review-assistant

# Allowed CORS origins as JSON array or comma-separated list.
# Examples:
#   []
#   http://localhost:3000,http://127.0.0.1:5173
#   ["http://localhost:3000", "http://127.0.0.1:5173"]
CORS_ORIGINS=[]

# Optional variables below are used by the sample LiteLLM proxy configs in docs/litellm/*.yaml.

# Primary upstream for docs/litellm/config.production_like.yaml
OPENAI_UPSTREAM_API_KEY=

# Anthropic fallback for docs/litellm/config.production_like.yaml
ANTHROPIC_API_KEY=

# Ollama endpoint for docs/litellm/config.production_like.yaml
OLLAMA_BASE_URL=
OLLAMA_API_KEY=

# Variables for docs/litellm/config.yaml local fallback demo
PRIMARY_OPENAI_API_KEY=
FALLBACK_OPENAI_BASE_URL=
FALLBACK_OPENAI_API_KEY=
